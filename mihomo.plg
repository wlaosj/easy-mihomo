    align-items: stretch;
}

.mihomo-dash-left {
    flex: 48;
    display: flex;
    flex-direction: column;
    min-width: 0;
}

.mihomo-dash-right {
    flex: 52;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    border-left: 1px dashed var(--border-color, rgba(128, 128, 128, 0.3));
    padding-left: 16px;
    min-width: 0;
}

.mihomo-list-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 7px 0;
    border-bottom: 1px dashed var(--border-color, rgba(128, 128, 128, 0.2));
}

.mihomo-list-row:last-child {
    border-bottom: none;
}

.mihomo-list-label-col {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 1.1rem;
    color: var(--text-muted, #666);
}

.mihomo-icon {
    font-size: 13px;
    color: var(--text-muted, #888);
}

.mihomo-list-value-col {
    font-size: 1.1rem;
    font-weight: bold;
    color: var(--text-color, #333);
    text-align: right;
    max-width: 55%;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

/* Canvas 图表容器 */
.mihomo-chart-container {
    position: relative;
    width: 100%;
    display: flex;
    justify-content: center;
}

#mihomo_speed_canvas {
    max-width: 100%;
    height: auto;
    display: block;
}

/* 图例样式 */
.mihomo-chart-legend {
    display: flex;
    gap: 12px;
    margin-top: 6px;
    font-size: 10px;
    color: var(--text-muted, #888);
}

.legend-item {
    display: flex;
    align-items: center;
    gap: 4px;
}

.legend-item .dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    display: inline-block;
}

.legend-item.dl .dot {
    background-color: #27ae60;
}

.legend-item.ul .dot {
    background-color: #e67e22;
}

/* 下拉菜单 (Select) 样式：完美自适应适配 Unraid 原生主题 */
.mihomo-select {
    font-size: 11px;
    font-weight: bold;
    color: var(--button-text-color, #333);
    background: var(--button-background, #f2f2f2);
    border: var(--button-border, 1px solid #ccc);
    padding: 3px 20px 3px 8px;
    border-radius: 4px;
    cursor: pointer;
    outline: none;
    -webkit-appearance: none;
    -moz-appearance: none;
    appearance: none;
    background-image: url('data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" width="8" height="8" viewBox="0 0 10 6"><path fill="%23666" d="M0 0h10L5 6z"/></svg>');
    background-repeat: no-repeat;
    background-position: right 6px center;
    transition: all 0.2s ease;
}

.mihomo-select:hover:not([disabled]) {
    border-color: var(--brand-orange, #e67e22);
}

.mihomo-select[disabled] {
    opacity: 0.6;
    cursor: not-allowed;
}

/* 按钮操作组布局 */
.mihomo-btn-group {
    display: flex;
    gap: 8px;
    padding: 0 16px 12px 16px;
    box-sizing: border-box;
    width: 100%;
}

.mihomo-btn {
    position: relative;
    flex: 1;
    height: 32px;
    border: none;
    border-radius: 6px;
    background: transparent !important;
    color: #fb8c00 !important;
    font-size: 12px;
    font-weight: bold;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    z-index: 1;
    transition: all 0.2s ease-in-out;
}

/* 使用遮罩混合 (mask-composite) 实现圆角渐变边框，100% 浏览器兼容，背景完全透明 */
.mihomo-btn::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    border-radius: 6px;
    padding: 1.5px; /* 边框厚度 */
    background: linear-gradient(to right, #e74c3c, #fb8c00);
    -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
    -webkit-mask-composite: xor;
    mask-composite: exclude;
    z-index: -1;
    transition: all 0.2s ease-in-out;
}

.mihomo-btn i {
    font-size: 11px;
    color: #fb8c00 !important;
    transition: all 0.2s ease-in-out;
}

/* 悬停状态：填充红橙渐变背景，文字图标反色为白，隐去边框 */
.mihomo-btn:hover {
    background: linear-gradient(to right, #e74c3c, #fb8c00) !important;
    color: #fff !important;
    transform: translateY(-1px);
    box-shadow: 0 4px 10px rgba(231, 76, 60, 0.2);
}

.mihomo-btn:hover::before {
    opacity: 0;
}

.mihomo-btn:hover i {
    color: #fff !important;
}

.mihomo-btn:active {
    transform: scale(0.97) translateY(0);
    box-shadow: 0 2px 5px rgba(231, 76, 60, 0.1);
}

</style>

<script type="text/javascript" src="/plugins/easy-mihomo/scripts/mihomo-dashboard.js"></script>
<script type="text/javascript">
// 全局网速历史队列 (预留 16 个点，确保滚动时右边界无缝闭合)
window.mihomoSpeedHistory = { dl: [], ul: [] };
window.mihomoLatestSpeed = { dl: 0, ul: 0 }; // 最新获取到的实际目标网速
window.mihomoLastFrameTime = Date.now();     // 上一帧渲染时间戳，用于计算 delta-time
window.mihomoChartOffset = 0;                 // 实时匀速滑动像素偏移量

// 格式化网速文本（用于 Canvas 刻度）
function formatSpeedText(bytes) {
    if (bytes < 1024) return bytes + ' B/s';
    var k = 1024;
    var sizes = ['B/s', 'kB/s', 'MB/s', 'GB/s'];
    var i = Math.floor(Math.log(bytes) / Math.log(k));
    i = Math.min(i, sizes.length - 1);
    var val = bytes / Math.pow(k, i);
    return (val < 10 ? val.toFixed(1) : Math.round(val)) + ' ' + sizes[i];
}

// 绘制网速折线阴影曲线图
function drawSpeedChart() {
    var canvas = document.getElementById('mihomo_speed_canvas');
    if (!canvas) return;
    var ctx = canvas.getContext('2d');
    var width = canvas.width;
    var height = canvas.height;
    
    // 清除画布
    ctx.clearRect(0, 0, width, height);
    
    var dlHistory = window.mihomoSpeedHistory.dl;
    var ulHistory = window.mihomoSpeedHistory.ul;
    var pointsCount = dlHistory.length;
    if (pointsCount === 0) return;
    
    // 计算历史数据中的最大速度，作为 Y 轴量程依据（最小刻度 1 kB/s = 1024 B/s）
    var maxVal = 1024;
    for (var i = 0; i < pointsCount; i++) {
        if (dlHistory[i] > maxVal) maxVal = dlHistory[i];
        if (ulHistory[i] > maxVal) maxVal = ulHistory[i];
    }
    
    // 绘图边距与布局设置 (左侧留出 42px 展示网速自适应刻度)
    var leftMargin = 42;
    var rightMargin = 2;
    var topMargin = 6;
    var bottomMargin = 6;
    
    var drawWidth = width - leftMargin - rightMargin;
    var drawHeight = height - topMargin - bottomMargin;
    
    // 1. 动态获取系统当前主题下的 CSS 变量真实颜色值，防止 Canvas 无法解析 CSS 变量字符串
    var tempEl = $('<span style="display:none;color:var(--text-muted, #888);border:1px solid var(--border-color, rgba(128,128,128,0.15));"></span>').appendTo('body');
    var textColor = tempEl.css('color') || '#888';
    var borderColor = tempEl.css('border-top-color') || 'rgba(128, 128, 128, 0.15)';
    tempEl.remove();

    // 2. 绘制 5 条静态水平刻度虚线 & 左侧刻度文字 (静态绘制，不受动画滚动影响)
    var gridLevels = [0, 0.25, 0.5, 0.75, 1]; // 0是最顶格(100%), 1是最低线(0%)
    ctx.strokeStyle = borderColor;
    ctx.lineWidth = 1;
    ctx.fillStyle = textColor;
    ctx.font = '8px sans-serif';
    ctx.textAlign = 'right';
    ctx.textBaseline = 'middle';
    
    for (var g = 0; g < gridLevels.length; g++) {
        var level = gridLevels[g];
        var gy = topMargin + drawHeight * level;
        
        // 绘制水平虚线 (从 leftMargin 到最右边)
        ctx.beginPath();
        ctx.setLineDash([3, 3]);
        ctx.moveTo(leftMargin, gy);
        ctx.lineTo(width - rightMargin, gy);
        ctx.stroke();
        ctx.setLineDash([]); // 还原实线
        
        // 绘制刻度数值
        var speedVal = maxVal * (1 - level);
        var labelText = (speedVal === 0) ? '0 B/s' : formatSpeedText(speedVal);
        ctx.fillText(labelText, leftMargin - 4, gy);
    }
    
    // 计算 X 轴步长 (仅在绘图区内，固定 15 个区间)
    var xStep = drawWidth / (15 - 1);
    
    // 3. 绘制面积曲线的通用函数 (启用局域裁剪，防止向左滚动时溢出左边界遮挡刻度)
    function drawLineAndArea(history, strokeColor, fillColor) {
        if (history.length < 2) return;
        var points = [];
        for (var idx = 0; idx < history.length; idx++) {
            // 所有点的 x 坐标均向左偏移当前累加值
            var px = leftMargin + idx * xStep - window.mihomoChartOffset;
            var py = topMargin + drawHeight * (1 - (history[idx] / maxVal));
            points.push({ x: px, y: py });
        }
        
        // 开启 Canvas 剪裁，强制只在绘图区内渲染波形
        ctx.save();
        ctx.beginPath();
        ctx.rect(leftMargin, topMargin, drawWidth, drawHeight);
        ctx.clip();
        
        // 绘制折线
        ctx.beginPath();
        ctx.moveTo(points[0].x, points[0].y);
        for (var idx = 1; idx < points.length; idx++) {
            ctx.lineTo(points[idx].x, points[idx].y);
        }
        ctx.strokeStyle = strokeColor;
        ctx.lineWidth = 1.5;
        ctx.lineJoin = 'round';
        ctx.lineCap = 'round';
        ctx.stroke();
        
        // 闭合区域绘制半透明填充 (底部闭合在 topMargin + drawHeight 线段上)
        ctx.lineTo(points[points.length - 1].x, topMargin + drawHeight);
        ctx.lineTo(points[0].x, topMargin + drawHeight);
        ctx.closePath();
        ctx.fillStyle = fillColor;
        ctx.fill();
        
        ctx.restore(); // 还原状态，避免影响后续其他操作
    }
    
    // 先绘制下载曲线 (绿色)
    drawLineAndArea(dlHistory, '#27ae60', 'rgba(39, 174, 96, 0.15)');
    
    // 后绘制上传曲线 (橙色)
    drawLineAndArea(ulHistory, '#e67e22', 'rgba(230, 126, 34, 0.12)');
}

function refreshMihomoDashboard() {
    $.getJSON('/plugins/easy-mihomo/api.php?cmd=dashboard_status', function(data) {
        if (data) {
            window.mihomoLastData = data;
            
            var statusIcon = $('.mihomo-status-icon');
            var statusText = $('.mihomo-status-text');
            var versionText = $('#mihomo-version');
            var serviceStatus = $('.mihomo-service-status');
            var configInfo = $('.mihomo-config-info');
            var memoryInfo = $('.mihomo-memory-info');
            var connInfo = $('.mihomo-conn-info');
            var dlSpeed = $('#mihomo_dl_speed');
            var ulSpeed = $('#mihomo_ul_speed');
            var modeSelect = $('#mihomo_mode_select');
            
            // 状态图标和文本
            statusIcon.removeClass('running stopped loading').addClass(data.running ? 'running' : 'stopped');
            statusText.text(data.running ? _('运行中') : _('已停止'));
            versionText.text(_('版本: ') + (data.version || _('未知')));
            
            // 运行状态行
            if (data.running) {
                serviceStatus.html('<span style="color:#28a745;font-weight:bold;">' + _('运行中') + '</span>');
                modeSelect.prop('disabled', false);
            } else {
                serviceStatus.html('<span style="color:#dc3545;font-weight:bold;">' + _('已停止') + '</span>');
                modeSelect.prop('disabled', true);
            }
            
            // 配置文件信息
            if (data.config && data.config.has_config) {
                var configName = data.config.selected_config || _('未知');
                configInfo.html('<span style="color:var(--text-color, #333);font-weight:bold;">' + configName + '</span>');
            } else {
                configInfo.html('<span style="color:#dc3545;">' + _('未选择配置') + '</span>');
            }
            
            // 代理模式下拉菜单同步
            if (data.running && data.mode) {
                window.mihomoUpdatingSelect = true;
                modeSelect.val(data.mode);
                window.mihomoUpdatingSelect = false;
            }
            
            // 实时速度同步，此处仅更新目标最新数据值，由独立动画时钟主导压入和移位，规避网络延迟卡顿
            var dlRaw = 0, ulRaw = 0;
            if (data.running) {
                dlSpeed.text(data.download_speed || '0 B/s');
                ulSpeed.text(data.upload_speed || '0 B/s');
                dlRaw = typeof data.download_speed_raw !== 'undefined' ? parseInt(data.download_speed_raw) : 0;
                ulRaw = typeof data.upload_speed_raw !== 'undefined' ? parseInt(data.upload_speed_raw) : 0;
            } else {
                dlSpeed.text('0 B/s');
                ulSpeed.text('0 B/s');
            }
            
            // 存储目标值，供滑动循环平滑读入
            window.mihomoLatestSpeed.dl = dlRaw;
            window.mihomoLatestSpeed.ul = ulRaw;
            
            // 资源占用同步
            if (data.running) {
                memoryInfo.html('<span style="color:var(--text-color, #333);font-weight:bold;">' + (data.memory || '0 MB') + '</span>');
                connInfo.html('<span style="color:#17a2b8;font-weight:bold;">' + (data.connections || 0) + '</span> ' + _('连接'));
            } else {
                memoryInfo.html('<span style="color:#6c757d;">' + _('未知') + '</span>');
                connInfo.html('<span style="color:#6c757d;">0</span> ' + _('连接'));
            }
        }
    }).fail(function() {
        $('.mihomo-status-icon').removeClass('running stopped').addClass('loading');
        $('.mihomo-status-text').text(_('状态: 错误'));
        $('.mihomo-service-status').text(_('错误'));
        $('.mihomo-config-info').text(_('错误'));
        $('#mihomo_mode_select').prop('disabled', true);
        $('#mihomo_dl_speed').text('0 B/s');
        $('#mihomo_ul_speed').text('0 B/s');
        $('.mihomo-memory-info').text(_('错误'));
        $('.mihomo-conn-info').html('0 ' + _('连接'));
        
        window.mihomoLatestSpeed.dl = 0;
        window.mihomoLatestSpeed.ul = 0;
    });
}

function mihomoAction(action) {
    switch(action) {
        case 'start':
        case 'stop':
        case 'restart':
            var actionText = '';
            switch(action) {
                case 'start': actionText = _('启动'); break;
                case 'stop': actionText = _('停止'); break;
                case 'restart': actionText = _('重启'); break;
            }
            
            $('.mihomo-status-text').text(_('状态: ') + actionText + _('中...'));
            $('.mihomo-status-icon').removeClass('running stopped').addClass('loading');
            $('#mihomo_mode_select').prop('disabled', true);
            
            $.get('/plugins/easy-mihomo/api.php?cmd=' + action, function(response) {
                setTimeout(function() {
                    refreshMihomoDashboard();
                }, 1000);
            }).fail(function() {
                $('.mihomo-status-text').text(_('状态: 操作失败'));
                $('.mihomo-status-icon').removeClass('running stopped loading').addClass('stopped');
            });
            break;
        case 'ui':
            var currentHostname = window.location.hostname;
            var port = null;
            if (window.mihomoLastData && window.mihomoLastData.config && window.mihomoLastData.config.port) {
                port = window.mihomoLastData.config.port;
            }
            
            if (!port) {
                alert('请在配置文件中设置 external-controller 端口');
                return;
            }
            
            var consoleUrl = 'http://' + currentHostname + ':' + port + '/ui/zashboard/#/proxies';
            window.open(consoleUrl, '_blank');
            break;
    }
}

$(document).ready(function() {
    $('#mihomo_mode_select').on('change', function() {
        if (window.mihomoUpdatingSelect) return;
        var selectedMode = $(this).val();
        var selectEl = $(this);
        
        selectEl.prop('disabled', true);
        $.get('/plugins/easy-mihomo/api.php?cmd=set_mode&mode=' + selectedMode, function(response) {
            setTimeout(function() {
                refreshMihomoDashboard();
            }, 800);
        }).fail(function() {
            alert(_('设置代理模式失败，请重试'));
            selectEl.prop('disabled', false);
        });
    });

    // 预填充满 16 个点以让折线从右侧平滑滑入，视觉更好
    for (var i = 0; i < 16; i++) {
        window.mihomoSpeedHistory.dl.push(0);
        window.mihomoSpeedHistory.ul.push(0);
    }

    // Canvas 匀速滑动渲染主循环 (25 FPS, 使用完全独立的 Delta-time 时钟驱动，彻底平滑网络请求延迟)
    function renderLoop() {
        var now = Date.now();
        var deltaTime = now - window.mihomoLastFrameTime;
        window.mihomoLastFrameTime = now;
        
        var canvas = document.getElementById('mihomo_speed_canvas');
        if (canvas) {
            var leftMargin = 42;
            var rightMargin = 2;
            var drawWidth = canvas.width - leftMargin - rightMargin;
            var xStep = drawWidth / (15 - 1); // 14个折线网格跨度
            
            // 匀速流动速度：每 2000 毫秒需要完整滚动过 1 个格子宽度（xStep）
            var speed = xStep / 2000;
            window.mihomoChartOffset += speed * deltaTime;
            
            // 当滑动累积超过 1 个格子时，将历史点移位，并压入当前的最新数值
            while (window.mihomoChartOffset >= xStep) {
                window.mihomoChartOffset -= xStep;
                
                window.mihomoSpeedHistory.dl.shift();
                window.mihomoSpeedHistory.ul.shift();
                
                window.mihomoSpeedHistory.dl.push(window.mihomoLatestSpeed.dl);
                window.mihomoSpeedHistory.ul.push(window.mihomoLatestSpeed.ul);
            }
            
            // 执行重绘
            drawSpeedChart();
        }
        
        window.requestAnimationFrame(renderLoop);
    }
    
    // 初始化时间戳并启动渲染
    window.mihomoLastFrameTime = Date.now();
    window.requestAnimationFrame(renderLoop);

    refreshMihomoDashboard();
    setInterval(refreshMihomoDashboard, 2000); // 每 2 秒异步刷新一次数据源
});
</script>
]]></INLINE>
</FILE>

<!-- post-install: setup menu entry -->
<FILE Run="/bin/bash">
<INLINE>
set -e
echo "Mihomo plugin installed. Persistent path: /boot/config/plugins/easy-mihomo"
</INLINE>
</FILE>

<!-- version cleanup -->
<FILE Run="/bin/bash">
<INLINE>
set -e
echo "Cleanup completed"
</INLINE>
</FILE>

<!-- remove -->
<FILE Run="/bin/bash" Method="remove">
<INLINE><![CDATA[
set -e
echo "正在卸载 Easy-Mihomo 插件..."

# 停止mihomo进程
echo "  - 正在停止 Mihomo 服务..."
if pgrep -x mihomo >/dev/null 2>&1; then
  echo "    检测到mihomo进程，正在停止..."
  pkill -9 -x mihomo 2>/dev/null || true
  # 等待进程完全停止
  sleep 2
  if pgrep -x mihomo >/dev/null 2>&1; then
    echo "    强制停止mihomo进程..."
    pkill -9 -x mihomo 2>/dev/null || true
    sleep 1
  fi
  echo "  ✓ Mihomo 服务已停止"
else
  echo "  ✓ Mihomo 服务未运行"
fi

# 卸载 UI bind 挂载（若存在）
echo "  - 卸载 UI 挂载..."
UI_MOUNT_DIR="/boot/config/plugins/easy-mihomo/ui/zashboard"
if [ -d "$UI_MOUNT_DIR" ] && mountpoint -q "$UI_MOUNT_DIR"; then
  echo "    检测到bind mount，正在卸载..."
  umount "$UI_MOUNT_DIR" 2>/dev/null || umount -l "$UI_MOUNT_DIR" 2>/dev/null || true
  echo "    bind mount已卸载"
elif [ -L "$UI_MOUNT_DIR" ]; then
  echo "    检测到软链接，正在删除..."
  rm -f "$UI_MOUNT_DIR" 2>/dev/null || true
  echo "    软链接已删除"
else
  echo "    无需处理UI挂载"
fi
echo "  ✓ UI 挂载处理完成"

# 清理PID文件
echo "  - 清理进程文件..."
rm -f /var/run/mihomo.pid
echo "  ✓ 进程文件已清理"

# 清理二进制文件
echo "  - 清理二进制文件..."
rm -f /usr/local/bin/mihomo
rm -f /boot/config/plugins/easy-mihomo/mihomo
echo "  ✓ 二进制文件已清理"

# 清理插件目录
echo "  - 清理插件目录..."
rm -rf /usr/local/emhttp/plugins/easy-mihomo
rm -f /boot/config/plugins/easy-mihomo/.version
rm -rf /boot/config/plugins/easy-mihomo
echo "  ✓ 插件目录已清理"

# 清理内存临时目录
echo "  - 清理内存临时目录..."
rm -rf /var/tmp/easy-mihomo-ui /var/tmp/easy-mihomo-progress /tmp/easy-mihomo-ui /tmp/mihomo-download
echo "  ✓ 内存临时目录已清理"

# 清理系统覆盖层文件（仅限本插件命名空间）
echo "  - 清理系统文件..."
rm -rf /var/local/overlay/usr/local/emhttp/plugins/easy-mihomo
rm -f /var/local/overlay/usr/local/emhttp/plugins/easy-mihomo.*
echo "  ✓ 系统文件已清理"

# 清理日志文件
echo "  - 清理日志文件..."
rm -f /var/log/mihomo.log
echo "  ✓ 日志文件已清理"

# 清理临时文件
echo "  - 清理临时文件..."
rm -f /tmp/mihomo
echo "  ✓ 临时文件已清理"

# 清理开机即启动注入与标志
echo "  - 清理开机启动配置..."
sed -i "/^# BEGIN easy-mihomo (do not edit)$/,/^# END easy-mihomo$/d" /boot/config/go 2>/dev/null || true
rm -f /boot/config/plugins/easy-mihomo/bootstart.enabled
echo "  ✓ 开机启动配置已清理"

# 清理定时任务
echo "  - 清理定时清理任务..."
crontab -l 2>/dev/null | grep -v "mihomo.*log_cleanup" | crontab - 2>/dev/null || true
echo "  ✓ 定时清理任务已清理"

echo ""
echo "🎉 Easy-Mihomo 插件卸载完成！"
echo "   所有相关文件和配置已完全清理。"
]]></INLINE>
</FILE>

</PLUGIN>
