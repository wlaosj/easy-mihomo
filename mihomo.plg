:root {
  --mih-bg: #f5f5f5;
  --mih-bg-card: #ffffff;
  --mih-bg-card-hover: #fafafa;
  --mih-border: #dddddd;
  --mih-text: #333333;
  --mih-text-dim: #777777;
  --mih-text-bright: #333333;
  --mih-accent: #e67e22;
  --mih-accent-hover: #d35400;
  --mih-accent-light: rgba(230,126,34,0.1);
  --mih-green: #27ae60;
  --mih-green-light: rgba(39,174,96,0.1);
  --mih-red: #e74c3c;
  --mih-red-light: rgba(231,76,60,0.1);
  --mih-yellow: #f39c12;
  --mih-yellow-light: rgba(243,156,18,0.1);
  --mih-blue: #3498db;
  --mih-radius: 12px;
  --mih-radius-sm: 8px;
  --mih-shadow: 0 1px 4px rgba(0,0,0,0.06);
}

/* Scoped under #easy-mihomo-settings to avoid polluting Unraid */
#easy-mihomo-settings {
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  color: var(--mih-text);
  line-height: 1.5;
  padding: 10px 0 30px 0;
  max-width: 1280px;
  margin: 0 auto;
  width: 100%;
}

#easy-mihomo-settings * {
  box-sizing: border-box;
}

#easy-mihomo-settings a {
  color: var(--mih-accent);
  text-decoration: none;
}

#easy-mihomo-settings a:hover {
  color: var(--mih-accent-hover);
  text-decoration: underline;
}

/* 头部 */
#easy-mihomo-settings .header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20px;
  flex-wrap: wrap;
  gap: 12px;
}
#easy-mihomo-settings .header h1 {
  font-size: 24px;
  font-weight: 700;
  color: var(--mih-text);
  display: flex;
  align-items: center;
  gap: 10px;
}
#easy-mihomo-settings .header h1 .icon { font-size: 28px; }
#easy-mihomo-settings .header-links {
  display: flex;
  gap: 8px;
  align-items: center;
  flex-wrap: wrap;
}
#easy-mihomo-settings .header-links a, 
#easy-mihomo-settings .header-links span {
  display: inline-flex;
  align-items: center;
  gap: 4px;
  padding: 5px 10px;
  border-radius: 6px;
  font-size: 12px;
  font-weight: 600;
  color: white;
  text-decoration: none;
  transition: opacity 0.2s;
}
#easy-mihomo-settings .header-links a:hover { opacity: 0.85; text-decoration: none; }
#easy-mihomo-settings .link-tg { background: #0088cc; }
#easy-mihomo-settings .link-github { background: #24292e; }

/* 紧凑型 Dashboard 双栏布局 */
#easy-mihomo-settings .dashboard-layout {
  display: flex;
  gap: 20px;
  align-items: flex-start;
  margin-top: 16px;
}
@media (max-width: 900px) {
  #easy-mihomo-settings .dashboard-layout {
    flex-direction: column;
    align-items: stretch;
  }
}
#easy-mihomo-settings .layout-left {
  flex: 4;
  display: flex;
  flex-direction: column;
  gap: 20px;
  min-width: 330px;
}
#easy-mihomo-settings .layout-right {
  flex: 6;
  display: flex;
  flex-direction: column;
  gap: 20px;
  min-width: 0;
}

#easy-mihomo-settings .card {
  background: var(--mih-bg-card);
  border: 1px solid var(--mih-border);
  border-radius: var(--mih-radius);
  padding: 16px;
  box-shadow: var(--mih-shadow);
  transition: border-color 0.2s;
}
#easy-mihomo-settings .card:hover { border-color: var(--mih-accent); }
#easy-mihomo-settings .card-title {
  font-size: 15px;
  font-weight: 700;
  color: var(--mih-text);
  margin-bottom: 12px;
  display: flex;
  align-items: center;
  gap: 8px;
}
#easy-mihomo-settings .card-title .badge {
  font-size: 10px;
  padding: 2px 8px;
  border-radius: 10px;
  font-weight: 600;
}
#easy-mihomo-settings .badge-green { background: var(--mih-green-light); color: var(--mih-green); }
#easy-mihomo-settings .badge-red { background: var(--mih-red-light); color: var(--mih-red); }
#easy-mihomo-settings .badge-blue { background: rgba(52,152,219,0.1); color: var(--mih-blue); }
#easy-mihomo-settings .badge-gray { background: rgba(119,119,119,0.1); color: var(--mih-text-dim); }
#easy-mihomo-settings .badge-orange { background: var(--mih-accent-light); color: var(--mih-accent); }

/* 表单行 */
#easy-mihomo-settings .form-row {
  display: flex;
  align-items: center;
  gap: 10px;
  margin-bottom: 8px;
  flex-wrap: wrap;
}
#easy-mihomo-settings .form-label {
  font-size: 13px;
  color: var(--mih-text-dim);
  min-width: 70px;
  flex-shrink: 0;
}
#easy-mihomo-settings .form-value {
  font-size: 13px;
  color: var(--mih-text);
  font-weight: 600;
}

/* 运行状态样式 */
#easy-mihomo-settings .status-indicator {
  display: flex;
  align-items: center;
  gap: 8px;
  margin-bottom: 12px;
  font-size: 16px;
  font-weight: 700;
}
#easy-mihomo-settings .status-dot {
  width: 10px;
  height: 10px;
  border-radius: 50%;
  display: inline-block;
}
#easy-mihomo-settings .status-dot.running {
  background: var(--mih-green);
  box-shadow: 0 0 8px var(--mih-green);
}
#easy-mihomo-settings .status-dot.stopped {
  background: var(--mih-red);
  box-shadow: 0 0 8px var(--mih-red);
}
#easy-mihomo-settings .status-dot.unknown {
  background: var(--mih-text-dim);
}
#easy-mihomo-settings .text-green { color: var(--mih-green); }
#easy-mihomo-settings .text-red { color: var(--mih-red); }
#easy-mihomo-settings .status-pid-val {
  font-size: 12px;
  color: var(--mih-text-dim);
  font-weight: normal;
}
#easy-mihomo-settings .service-actions {
  display: flex;
  gap: 8px;
  flex-wrap: wrap;
  width: 100%;
}
#easy-mihomo-settings .service-actions .btn {
  flex: 1;
  min-width: 75px;
}

/* 按钮优化 */
#easy-mihomo-settings .btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 6px;
  padding: 6px 14px;
  border: none;
  border-radius: 6px;
  font-size: 13px;
  font-weight: 600;
  cursor: pointer;
  transition: all 0.2s ease-in-out;
  color: white;
}
#easy-mihomo-settings .btn:hover {
  transform: translateY(-1px);
  box-shadow: 0 4px 10px rgba(0,0,0,0.12);
  filter: brightness(1.08);
}
#easy-mihomo-settings .btn:active {
  transform: translateY(0);
}
#easy-mihomo-settings .btn:disabled { opacity: 0.5; cursor: not-allowed; transform: none; box-shadow: none; }
#easy-mihomo-settings .btn-green { background: var(--mih-green); }
#easy-mihomo-settings .btn-red { background: var(--mih-red); }
#easy-mihomo-settings .btn-yellow { background: var(--mih-yellow); color: white !important; }
#easy-mihomo-settings .btn-dark { background: #555555; }
#easy-mihomo-settings .btn-accent { background: var(--mih-accent); }
#easy-mihomo-settings .btn-sm { padding: 4px 10px; font-size: 12px; }

/* 订阅卡片样式 */
#easy-mihomo-settings .sub-list-container {
  display: flex;
  flex-direction: column;
  gap: 12px;
  margin-top: 10px;
}
#easy-mihomo-settings .sub-item-card {
  border: 1px solid var(--mih-border);
  background: var(--mih-bg-card-hover, #fafafa);
  border-radius: var(--mih-radius-sm);
  padding: 12px 14px;
  display: flex;
  flex-direction: column;
  gap: 8px;
}
#easy-mihomo-settings .sub-item-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
}
#easy-mihomo-settings .sub-item-name {
  font-weight: 700;
  font-size: 13px;
  color: var(--mih-text);
}
#easy-mihomo-settings .sub-item-percent {
  font-weight: 700;
  font-size: 13px;
}
#easy-mihomo-settings .sub-progress-bar-bg {
  width: 100%;
  height: 6px;
  background: var(--mih-border, #ddd);
  border-radius: 3px;
  overflow: hidden;
}
#easy-mihomo-settings .sub-progress-bar-fill {
  height: 100%;
  border-radius: 3px;
  transition: width 0.3s ease;
}
#easy-mihomo-settings .sub-item-footer {
  display: flex;
  justify-content: space-between;
  font-size: 11px;
  color: var(--mih-text-dim);
}

/* 选择框 */
#easy-mihomo-settings select {
  background: white;
  color: var(--mih-text);
  border: 1px solid var(--mih-border);
  border-radius: var(--mih-radius-sm);
  padding: 5px 10px;
  font-size: 13px;
  cursor: pointer;
  transition: border-color 0.2s;
}
#easy-mihomo-settings select:hover, 
#easy-mihomo-settings select:focus { border-color: var(--mih-accent); outline: none; }

/* 提示框 */
#easy-mihomo-settings .tip {
  background: var(--mih-accent-light);
  border-left: 3px solid var(--mih-accent);
  border-radius: 0 var(--mih-radius-sm) var(--mih-radius-sm) 0;
  padding: 8px 12px;
  font-size: 12px;
  color: var(--mih-text-dim);
  margin-top: 10px;
  line-height: 1.6;
}
#easy-mihomo-settings .tip strong { color: var(--mih-text); }
#easy-mihomo-settings .tip a { color: var(--mih-accent-hover); }

/* 提示 */
#easy-mihomo-settings .alert { padding: 10px 14px; border-radius: var(--mih-radius-sm); margin-bottom: 16px; font-size: 13px; }
#easy-mihomo-settings .alert-warning { background: var(--mih-yellow-light); border: 1px solid rgba(243,156,18,0.3); color: #b87500; }
#easy-mihomo-settings .alert-error { background: var(--mih-red-light); border: 1px solid rgba(231,76,60,0.3); color: var(--mih-red); }
#easy-mihomo-settings .alert-success { background: var(--mih-green-light); border: 1px solid rgba(39,174,96,0.3); color: var(--mih-green); }

/* 进度文本 */
#easy-mihomo-settings .progress-text { font-size: 12px; color: var(--mih-text-dim); margin-top: 4px; }

/* 日志/预格式 */
#easy-mihomo-settings #logContent {
  background: #fafafa;
  border: 1px solid var(--mih-border);
  border-radius: var(--mih-radius-sm);
  padding: 12px;
  max-height: 360px;
  overflow: auto;
  font-size: 12px;
  line-height: 1.5;
  color: var(--mih-text);
}

/* 弹窗 */
#easy-mihomo-settings .modal-overlay {
  display: none;
  position: fixed;
  top: 0; left: 0;
  width: 100%; height: 100%;
  background: rgba(0,0,0,0.4);
  z-index: 1000;
  overflow: auto;
}
#easy-mihomo-settings .modal-content {
  position: relative;
  margin: 5% auto;
  background: var(--mih-bg-card);
  border: 1px solid var(--mih-border);
  border-radius: var(--mih-radius);
  padding: 24px;
  width: 90%;
  max-width: 1200px;
  min-height: 500px;
  box-shadow: 0 8px 32px rgba(0,0,0,0.15);
}
#easy-mihomo-settings .modal-content h3 {
  color: var(--mih-text);
  margin-bottom: 16px;
  padding-bottom: 12px;
  border-bottom: 1px solid var(--mih-border);
}
#easy-mihomo-settings .modal-content textarea {
  width: 100%;
  height: 450px;
  background: #fafafa;
  color: var(--mih-text);
  border: 1px solid var(--mih-border);
  border-radius: var(--mih-radius-sm);
  padding: 12px;
  font-family: 'SF Mono', 'Fira Code', monospace;
  font-size: 13px;
  resize: vertical;
}
#easy-mihomo-settings .modal-content textarea:focus { border-color: var(--mih-accent); outline: none; }
#easy-mihomo-settings .modal-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 16px;
  padding-top: 12px;
  border-top: 1px solid var(--mih-border);
}
#easy-mihomo-settings .header-links .lang-toggle {
  display: inline-flex;
  align-items: center;
  padding: 3px 8px;
  border-radius: 4px;
  font-size: 12px;
  font-weight: 600;
  color: var(--mih-accent);
  background: transparent;
  border: 1px solid var(--mih-accent);
  text-decoration: none;
  transition: all 0.2s;
}
#easy-mihomo-settings .header-links .lang-toggle:hover {
  background: var(--mih-accent);
  color: white;
  text-decoration: none;
}
/* 代码编辑器样式 - Scoped under #configModal to avoid pollution */
#configModal .code-editor-container {
  display: flex;
  background: #1e1e1e !important;
  color: #d4d4d4 !important;
  border: 1px solid var(--mih-border, #dddddd);
  border-radius: var(--mih-radius-sm, 8px);
  font-family: 'SF Mono', 'Fira Code', Consolas, Monaco, monospace;
  font-size: 13px;
  position: relative;
  height: 480px;
  overflow: hidden;
  margin-top: 10px;
}

#configModal .line-numbers {
  width: 42px;
  padding: 12px 0;
  text-align: right;
  padding-right: 10px;
  border-right: 1px solid #3c3c3c;
  color: #858585;
  background: #1e1e1e;
  user-select: none;
  overflow: hidden;
  line-height: 1.5;
}

#configModal .editor-area {
  flex: 1;
  position: relative;
  height: 100%;
}

#configModal #editor-textarea, 
#configModal #highlight-overlay {
  width: 100%;
  height: 100%;
  margin: 0;
  padding: 12px;
  border: none;
  font-family: inherit;
  font-size: inherit;
  line-height: 1.5;
  white-space: pre;
  word-wrap: normal;
  overflow: auto;
  position: absolute;
  top: 0;
  left: 0;
  background: transparent;
}

#configModal #editor-textarea {
  color: transparent !important;
  caret-color: #ffffff !important;
  resize: none;
  z-index: 2;
  outline: none;
}

#configModal #highlight-overlay {
  z-index: 1;
  color: #d4d4d4;
  pointer-events: none;
  overflow: hidden;
  max-height: none !important;
  height: 100% !important;
}

#configModal #highlight-code {
  font-family: inherit;
  font-size: inherit;
  line-height: inherit;
  background: transparent;
  padding: 0;
  margin: 0;
  border: none;
  border-radius: 0;
  white-space: pre;
}

/* YAML 语法高亮配色 */
#configModal .yaml-comment { color: #6a9955 !important; font-style: italic; }
#configModal .yaml-key { color: #9cdcfe !important; font-weight: bold; }
#configModal .yaml-string { color: #ce9178 !important; }
#configModal .yaml-number { color: #b5cea8 !important; }
#configModal .yaml-bool { color: #569cd6 !important; font-weight: bold; }
#configModal .yaml-anchor { color: #c586c0 !important; }
</style>
<script>
function executeAction(action) {
  // 使用GET参数直接跳转
  var url = new URL(window.location);
  url.searchParams.set('cmd', action);
  window.location.href = url.toString();
}

function openConsole() {
  // 获取当前页面的主机名（不包含端口）
  var currentHostname = window.location.hostname;
  // 从页面中获取动态端口信息
  var portSpans = document.querySelectorAll('span');
  var port = null;
  for (var i = 0; i < portSpans.length; i++) {
    if (portSpans[i].textContent === '端口：') {
      var nextSpan = portSpans[i].nextElementSibling;
      if (nextSpan && nextSpan.tagName === 'SPAN') {
        var portText = nextSpan.textContent.trim();
        // 检查是否包含"未设置"文本（处理嵌套span的情况）
        if (portText && portText !== '未设置' && !portText.includes('未设置')) {
          port = portText;
        }
        break;
      }
    }
  }
  
  // 如果没找到端口，尝试通过更简单的方法获取
  if (!port) {
    // 查找包含端口号的span元素
    var allSpans = document.querySelectorAll('span');
    for (var j = 0; j < allSpans.length; j++) {
      var text = allSpans[j].textContent.trim();
      // 检查是否是纯数字（端口号）
      if (/^\d+$/.test(text) && parseInt(text) > 0 && parseInt(text) < 65536) {
        port = text;
        break;
      }
    }
  }
  
  if (!port) {
    alert('Please set external-controller port in config file');
    return;
  }
  
  var consoleUrl = 'http://' + currentHostname + ':' + port + '/ui/zashboard/#/proxies';
  // 在新标签页中打开控制台
  window.open(consoleUrl, '_blank');
}

function openFileManager() {
  // 获取当前页面的主机名和端口
  var currentHostname = window.location.hostname;
  var currentPort = window.location.port;
  // 构建文件管理器URL，直接定位到插件配置目录
  var fileManagerUrl = 'http://' + currentHostname + ':' + currentPort + '/Main/Browse?dir=%2Fboot%2Fconfig%2Fplugins%2Feasy-mihomo';
  // 在新标签页中打开文件管理器
  window.open(fileManagerUrl, '_blank');
}

// 全局变量存储更新状态
window.updateCheckData = null;

function checkUpdate(silent) {
  var updateInfo = document.getElementById('update-info');
  if (updateInfo && !silent) {
    updateInfo.innerHTML = '<span style="color:#777777;">检查中...</span>';
  }
  
  var xhr = new XMLHttpRequest();
  xhr.open('GET', '/plugins/easy-mihomo/api.php?cmd=check_update');
  xhr.onload = function(){
    if (xhr.status === 200) {
      try {
        var data = JSON.parse(xhr.responseText);
        // 保存到全局变量
        window.updateCheckData = data;
        
        var localVer = document.getElementById('local-version');
        
        if (localVer && data.local && data.local !== 'not installed') {
          localVer.textContent = data.local;
        }
        
        if (updateInfo) {
          if (data.has_update) {
            if (data.local === 'not installed') {
              updateInfo.innerHTML = '<span style="color:#e74c3c;">' + data.message + '</span>';
            } else {
              updateInfo.innerHTML = '<span style="color:#ffc107;">' + data.message + '</span>';
            }
          } else {
            updateInfo.innerHTML = '<span style="color:#27ae60;">' + data.message + '</span>';
          }
          
          // 5秒后自动清除消息（如果是已是最新版本）
          if (!data.has_update && !silent) {
            setTimeout(function(){ 
              if (updateInfo) updateInfo.innerHTML = ''; 
            }, 5000);
          }
        }
        
        // 更新下载按钮状态
        updateDownloadButtonState();
        
      } catch (e) {
        if (updateInfo && !silent) {
          updateInfo.innerHTML = '<span style="color:#e74c3c;">解析失败</span>';
        }
      }
    } else {
      if (updateInfo && !silent) {
        updateInfo.innerHTML = '<span style="color:#e74c3c;">检查失败</span>';
      }
    }
  };
  xhr.onerror = function(){
    if (updateInfo && !silent) {
      updateInfo.innerHTML = '<span style="color:#e74c3c;">网络错误</span>';
    }
  };
  xhr.send();
}

// 检查 UI 更新
function checkUIUpdate(silent) {
  var uiUpdateInfo = document.getElementById('ui-update-info');
  if (uiUpdateInfo && !silent) {
    uiUpdateInfo.innerHTML = '<span style="color:#777777;">检查中...</span>';
  }
  
  var xhr = new XMLHttpRequest();
  xhr.open('GET', '/plugins/easy-mihomo/api.php?cmd=check_ui_update');
  xhr.onload = function(){
    if (xhr.status === 200) {
      try {
        var data = JSON.parse(xhr.responseText);
        // 保存到全局变量
        window.uiUpdateCheckData = data;
        
        var localVer = document.getElementById('ui-local-version');
        
        if (localVer && data.local && data.local !== 'not installed') {
          localVer.textContent = data.local;
        }
        
        if (uiUpdateInfo) {
          if (data.has_update) {
            if (data.local === 'not installed') {
              uiUpdateInfo.innerHTML = '<span style="color:#e74c3c;">' + data.message + '</span>';
            } else {
              uiUpdateInfo.innerHTML = '<span style="color:#ffc107;">' + data.message + '</span>';
            }
          } else {
            uiUpdateInfo.innerHTML = '<span style="color:#27ae60;">' + data.message + '</span>';
          }
          
          // 5秒后自动清除消息（如果是已是最新版本）
          if (!data.has_update && !silent) {
            setTimeout(function(){ 
              if (uiUpdateInfo) uiUpdateInfo.innerHTML = ''; 
            }, 5000);
          }
        }
        
        // 更新 UI 下载按钮状态
        updateUIDownloadButtonState();
        
      } catch (e) {
        if (uiUpdateInfo && !silent) {
          uiUpdateInfo.innerHTML = '<span style="color:#e74c3c;">解析失败</span>';
        }
      }
    } else {
      if (uiUpdateInfo && !silent) {
        uiUpdateInfo.innerHTML = '<span style="color:#e74c3c;">检查失败</span>';
      }
    }
  };
  xhr.onerror = function(){
    if (uiUpdateInfo && !silent) {
      uiUpdateInfo.innerHTML = '<span style="color:#e74c3c;">网络错误</span>';
    }
  };
  xhr.send();
}

// 更新 UI 下载按钮状态
function updateUIDownloadButtonState() {
  var downloadBtn = document.getElementById('download-ui-btn');
  if (!downloadBtn) return;
  
  // 检查是否正在下载
  var progressBox = document.getElementById('progress-ui');
  if (progressBox && progressBox.textContent && progressBox.textContent.includes('%')) {
    downloadBtn.disabled = true;
    downloadBtn.style.background = '#777777';
    downloadBtn.style.cursor = 'not-allowed';
    downloadBtn.textContent = '下载中...';
    return;
  }
  
  // 启用按钮
  downloadBtn.disabled = false;
  downloadBtn.style.cursor = 'pointer';
  
  if (window.uiUpdateCheckData) {
    var data = window.uiUpdateCheckData;
    if (data.has_update) {
      if (data.local === 'not installed') {
        downloadBtn.style.background = '#27ae60';
        downloadBtn.textContent = '下载 UI';
      } else {
        downloadBtn.style.background = '#f39c12';
        downloadBtn.style.color = '#000';
        downloadBtn.textContent = '更新到 ' + data.remote;
      }
    } else {
      downloadBtn.style.background = '#777777';
      downloadBtn.textContent = '重新安装';
    }
  } else {
    downloadBtn.style.background = '#e67e22';
    downloadBtn.textContent = '下载/更新 UI';
  }
}

// 智能下载 UI 函数
function smartDownloadUI(target, btn) {
  // 检查是否正在下载
  var progressBox = document.getElementById('progress-ui');
  if (progressBox && progressBox.textContent && progressBox.textContent.includes('%')) {
    alert('Download in progress, please wait');
    return;
  }
  
  // 检查是否有更新信息
  if (!window.uiUpdateCheckData) {
    // 没有检查过更新，先检查
    if (confirm('Download latest UI?\n\nContinue?')) {
      startDownload(target, btn);
    }
    return;
  }
  
  var data = window.uiUpdateCheckData;
  
  // 根据更新状态给出不同提示
  if (data.has_update) {
    // 有新版本
    var confirmMsg = '';
    if (data.local === 'not installed') {
      confirmMsg = 'Download UI\n\nLatest: ' + data.remote + '\n\nContinue?';
    } else {
      confirmMsg = 'New version available\n\nCurrent: ' + data.local + '\nLatest: ' + data.remote + '\n\nUpdate?';
    }

    if (confirm(confirmMsg)) {
      startDownload(target, btn);
    }
  } else {
    // 已是最新版本，询问是否重新安装
    var reinstallMsg = 'Already latest: ' + data.remote + '\n\nReinstall?';
    if (confirm(reinstallMsg)) {
      startDownload(target, btn);
    }
  }
}

// 检查服务是否运行
function checkServiceRunning() {
  var statusElements = document.querySelectorAll('span[style*="color:#27ae60"]');
  for (var i = 0; i < statusElements.length; i++) {
    if (statusElements[i].textContent.includes('运行中')) {
      return true;
    }
  }
  return false;
}

// 更新下载按钮状态
function updateDownloadButtonState() {
  var downloadBtn = document.getElementById('download-btn');
  var updateInfo = document.getElementById('update-info');
  
  if (!downloadBtn) return;
  
  // 检查是否正在下载
  var progressBox = document.getElementById('progress-core');
  if (progressBox && progressBox.textContent && progressBox.textContent.includes('%')) {
    downloadBtn.disabled = true;
    downloadBtn.style.background = '#777777';
    downloadBtn.style.cursor = 'not-allowed';
    downloadBtn.textContent = '下载中...';
    return;
  }
  
  // 始终启用按钮（即使服务正在运行也允许下载核心）
  // 原因：下载核心需要魔法网络（代理），停止服务会导致无法下载
  // 新核心会保存到U盘并删除内存核心，重启服务后自动从U盘加载
  downloadBtn.disabled = false;
  downloadBtn.style.cursor = 'pointer';
  
  if (window.updateCheckData) {
    var data = window.updateCheckData;
    if (data.has_update) {
      if (data.local === 'not installed') {
        downloadBtn.style.background = '#27ae60';
        downloadBtn.textContent = '下载核心';
      } else {
        downloadBtn.style.background = '#f39c12';
        downloadBtn.style.color = '#000';
        downloadBtn.textContent = '更新到 ' + data.remote;
      }
    } else {
      downloadBtn.style.background = '#777777';
      downloadBtn.textContent = '重新安装';
    }
  } else {
    downloadBtn.style.background = '#e67e22';
    downloadBtn.textContent = '下载/更新核心';
  }
}

// 智能下载函数
function smartDownload(target, btn) {
  // 检查是否正在下载
  var progressBox = document.getElementById('progress-core');
  if (progressBox && progressBox.textContent && progressBox.textContent.includes('%')) {
    alert('Download in progress, please wait');
    return;
  }
  
  // 检查服务是否运行（用于提示，不阻止下载）
  var isServiceRunning = checkServiceRunning();
  
  // 检查是否有更新信息
  if (!window.updateCheckData) {
    // 没有检查过更新，先检查
    var msg = 'Download core\n\nContinue?';
    if (isServiceRunning) {
      msg = 'Download core\n\nNote: Service is running. Restart required after download.\n\nContinue?';
    }
    if (confirm(msg)) {
      startDownload(target, btn);
    }
    return;
  }
  
  var data = window.updateCheckData;
  
  // 根据更新状态给出不同提示
  if (data.has_update) {
    // 有新版本
    var confirmMsg = '';
    if (data.local === 'not installed') {
      confirmMsg = 'Download core\n\nLatest: ' + data.remote + '\n\nContinue?';
      if (isServiceRunning) {
        confirmMsg = 'Download core\n\nLatest: ' + data.remote + '\n\nNote: Service is running. Restart required after download.\n\nContinue?';
      }
    } else {
      confirmMsg = 'New version available\n\nCurrent: ' + data.local + '\nLatest: ' + data.remote + '\n\nUpdate?';
      if (isServiceRunning) {
        confirmMsg = 'New version available\n\nCurrent: ' + data.local + '\nLatest: ' + data.remote + '\n\nNote: Service is running. Restart required after download.\n\nUpdate?';
      }
    }
    
    if (confirm(confirmMsg)) {
      startDownload(target, btn);
    }
  } else {
    // 已是最新版本，询问是否重新安装
    var reinstallMsg = 'Already latest: ' + data.remote + '\n\nReinstall? (Can fix corrupted files)';
    if (isServiceRunning) {
      reinstallMsg = 'Already latest: ' + data.remote + '\n\nNote: Service is running. Restart required after download.\n\nReinstall?';
    }
    if (confirm(reinstallMsg)) {
      startDownload(target, btn);
    }
  }
}

function startDownload(target, btn) {
  // 清除旧的进度/错误信息（开始新操作）
  var progressBox = document.getElementById('progress-' + target);
  if (progressBox) {
    progressBox.innerHTML = '';
    progressBox.style.color = '';
    progressBox.style.opacity = '1';
  }
  
  // 禁用所有下载按钮，防止重复点击
  var downloadBtn = document.getElementById('download-btn');
  if (downloadBtn) {
    downloadBtn.dataset.oldText = downloadBtn.innerText;
    downloadBtn.dataset.oldColor = downloadBtn.style.background;
    downloadBtn.disabled = true;
    downloadBtn.style.background = '#777777';
    downloadBtn.style.cursor = 'not-allowed';
    downloadBtn.innerText = '下载中...';
  }
  
    var box = document.getElementById('download-msg');
    if (box) box.innerText = '已发起下载任务，正在准备...';
  
  var xhr = new XMLHttpRequest();
  xhr.open('GET', '/plugins/easy-mihomo/api.php?cmd=start_download&target=' + encodeURIComponent(target));
  xhr.onload = function(){
    if (xhr.status === 200) {
      if (box) box.innerText = (xhr.responseText || '').trim() || '任务已启动';
    } else {
      // 下载启动失败，恢复按钮
      if (downloadBtn) {
        downloadBtn.disabled = false;
        downloadBtn.style.background = downloadBtn.dataset.oldColor || '#e67e22';
        downloadBtn.style.cursor = 'pointer';
        downloadBtn.innerText = downloadBtn.dataset.oldText || '下载核心';
      }
      // 显示错误
      if (progressBox) {
        progressBox.innerHTML = 'Download failed, please retry';
        progressBox.style.color = '#e74c3c';
      }
    }
  };
  xhr.onerror = function(){
    // 网络错误，恢复按钮
    if (downloadBtn) {
      downloadBtn.disabled = false;
      downloadBtn.style.background = downloadBtn.dataset.oldColor || '#e67e22';
      downloadBtn.style.cursor = 'pointer';
      downloadBtn.innerText = downloadBtn.dataset.oldText || '下载核心';
    }
    // 显示错误
    if (progressBox) {
      progressBox.innerHTML = 'Network error, check connection';
      progressBox.style.color = '#e74c3c';
    }
  };
  xhr.send();
}

function pollProgress(target, elId) {
  var lastStatus = '';
  var errorTimeout = null;
  var autoHideTimeout = null;
  var intervalId = null;
  
  function tick(){
    var xhr = new XMLHttpRequest();
    xhr.open('GET', '/plugins/easy-mihomo/api.php?cmd=get_progress&target=' + encodeURIComponent(target));
    xhr.onload = function(){
      if (xhr.status === 200) {
        var box = document.getElementById(elId);
        if (!box) return;
        
        var txt = xhr.responseText || '';
        if (txt.trim()) {
          lastStatus = txt;
          
          // 检测错误信息
          if (txt.includes('error:')) {
            box.style.color = '#e74c3c';  // 红色
            box.style.opacity = '1';
            
            // 构建错误消息：错误内容 + 重试链接 + 关闭按钮
            var errorMsg = txt.replace('error:', 'Error:');
            box.innerHTML = errorMsg + 
              ' <a href="javascript:void(0)" onclick="smartDownload(\'' + target + '\', this); return false;" style="color:#007bff;text-decoration:underline;cursor:pointer;">重试</a>' +
              ' <span onclick="clearErrorMessage(\'' + elId + '\')" style="color:#999;margin-left:8px;cursor:pointer;font-size:18px;line-height:1;font-weight:bold;transition:color 0.2s;" title="关闭提示" onmouseover="this.style.color=\'#dc3545\'" onmouseout="this.style.color=\'#999\'">×</span>';
            
            // 清除之前的定时器
            if (errorTimeout) clearTimeout(errorTimeout);
            if (autoHideTimeout) clearTimeout(autoHideTimeout);
            
            // 10秒后半透明显示（提示信息已过期）
            errorTimeout = setTimeout(function() {
              if (box && box.innerHTML.includes('Error:')) {
                box.style.opacity = '0.6';

                // 再过20秒（总共30秒）自动消失
                autoHideTimeout = setTimeout(function() {
                  if (box && box.innerHTML.includes('Error:')) {
                    box.innerHTML = '';
                    box.style.opacity = '1';
                    box.style.color = '';
                  }
                }, 20000);
              }
            }, 10000);
            
          } else if (txt.includes('100%')) {
            // 下载完成
            box.style.color = '#27ae60';  // 绿色
            box.style.opacity = '1';
          box.innerText = txt;
            
            setTimeout(function(){
              if (box) {
                // 检查服务是否运行
                var isServiceRunning = checkServiceRunning();
                if (isServiceRunning && target === 'core') {
                  // 核心下载完成且服务正在运行
                  box.innerHTML = 'Core downloaded. <span style="color:#f39c12;font-weight:bold;">Restart service to apply.</span>';
                  // 不自动刷新页面，让用户看到提示
        } else {
                  // 服务未运行或下载的是UI，正常刷新
                  box.innerText = 'Download complete, refreshing...';
                  // 刷新页面以显示新版本
                  setTimeout(function(){
                    window.location.reload();
                  }, 2000);
                }
              }
            }, 1000);
            
          } else {
            // 正常进度
            box.style.color = '#777777';  // 灰色
            box.style.opacity = '1';
            box.innerText = txt;
          }
        } else {
          // 进度文件已被清理
          if (lastStatus && lastStatus.includes('%') && !lastStatus.includes('100%') && !lastStatus.includes('error:')) {
            // 如果之前有进度但不是100%或错误，现在没了，说明可能中断
            box.innerText = 'Download may have been interrupted';
            box.style.color = '#f39c12';
            setTimeout(function(){ if (box) box.innerText=''; }, 5000);
          } else if (lastStatus.includes('100%')) {
            // 已经完成了
            if (box) box.innerText = '';
          }
          lastStatus = '';
        }
      }
    };
    xhr.send();
  }
  
  tick();
  intervalId = setInterval(tick, 2000);
  return intervalId;
}

// 手动清除错误消息
function clearErrorMessage(elementId) {
  var box = document.getElementById(elementId);
  if (box) {
    box.innerHTML = '';
    box.style.opacity = '1';
    box.style.color = '';
  }
}

function openConfigEditor() {
  document.getElementById('configModal').style.display = 'block';
  // 禁用页面滚动
  document.body.style.overflow = 'hidden';
  // 初始化代码编辑器
  setTimeout(function() {
    updateEditor();
  }, 50);
}

function closeConfigEditor() {
  document.getElementById('configModal').style.display = 'none';
  // 恢复页面滚动
  document.body.style.overflow = 'auto';
}

// 点击背景关闭弹出窗口
document.addEventListener('click', function(event) {
  var modal = document.getElementById('configModal');
  if (event.target === modal) {
    closeConfigEditor();
  }
});

// ESC键关闭弹出窗口
document.addEventListener('keydown', function(event) {
  if (event.key === 'Escape') {
    closeConfigEditor();
  }
});

