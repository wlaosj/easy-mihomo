      <button onclick="executeLogAction('clearlog')" class="btn btn-red btn-sm">
        <i class="fa fa-trash"></i> <?= t('clear_log') ?>
      </button>
    </div>
    <pre id="logContent" style="max-height:500px;white-space:pre-wrap;word-wrap:break-word;"><?= htmlspecialchars($logTail) ?></pre>
    <div class="modal-footer">
      <div style="font-size:12px;color:var(--text-dim);">
        <?= t('log_auto_clean') ?>
      </div>
      <button onclick="closeLogViewer()" class="btn btn-dark"><?= t('close') ?></button>
    </div>
  </div>
</div>

<div id="download-msg" style="font-size:12px;color:#777777;margin-top:6px"></div>
<script>
// 页面加载后开始轮询进度
pollProgress('core', 'progress-core');
pollProgress('ui', 'progress-ui');

// HTML实体转义函数
function escapeHtml(text) {
  var map = {
    '&': '&amp;',
    '<': '&lt;',
    '>': '&gt;',
    '"': '&quot;',
    "'": '&#039;'
  };
  return text.replace(/[&<>"']/g, function(m) { return map[m]; });
}

// 动态载入订阅流量数据并绘制进度卡片
function loadSubscriptionStatus() {
  var xhr = new XMLHttpRequest();
  xhr.open('GET', '/plugins/easy-mihomo/api.php?cmd=subscription_status');
  xhr.onload = function() {
    if (xhr.status === 200) {
      try {
        var data = JSON.parse(xhr.responseText);
        var card = document.getElementById('subscription-card');
        var list = document.getElementById('subscription-list');
        if (!card || !list) return;
        
        if (data && data.length > 0) {
          card.style.display = 'block';
          
          var html = '';
          for (var i = 0; i < data.length; i++) {
            var item = data[i];
            
            // 根据百分比动态决定进度条颜色
            var fillColor = '#27ae60'; // 正常绿色
            if (item.percent >= 90) {
              fillColor = '#e74c3c'; // 红色（额度告急）
            } else if (item.percent >= 70) {
              fillColor = '#f39c12'; // 黄色
            }
            
            html += '<div class="sub-item-card">';
            html += '  <div class="sub-item-header">';
            html += '    <span class="sub-item-name">' + escapeHtml(item.name) + '</span>';
            html += '    <span class="sub-item-percent" style="color:' + fillColor + ';">' + item.percent + '%</span>';
            html += '  </div>';
            html += '  <div class="sub-progress-bar-bg">';
            html += '    <div class="sub-progress-bar-fill" style="width:' + item.percent + '%; background:' + fillColor + ';"></div>';
            html += '  </div>';
            html += '  <div class="sub-item-footer">';
            html += '    <span>' + '<?= t('traffic_used') ?>' + ': ' + item.used + ' / ' + '<?= t('traffic_total') ?>' + ': ' + item.total + '</span>';
            html += '    <span>' + '<?= t('traffic_remaining') ?>' + ': ' + item.remaining + ' | ' + '<?= t('expire_time') ?>' + ': ' + item.expire + '</span>';
            html += '  </div>';
            html += '</div>';
          }
          list.innerHTML = html;
        } else {
          card.style.display = 'none';
        }
      } catch (e) {
        document.getElementById('subscription-card').style.display = 'none';
      }
    } else {
      document.getElementById('subscription-card').style.display = 'none';
    }
  };
  xhr.onerror = function() {
    document.getElementById('subscription-card').style.display = 'none';
  };
  xhr.send();
}

// 页面加载后自动检查更新（静默模式）
window.addEventListener('load', function() {
  // 1秒后检查核心更新
  setTimeout(function() {
    checkUpdate(true); // 静默模式，不显示"检查中..."提示
  }, 1000);
  
  // 1.2秒后获取订阅流量额度
  setTimeout(function() {
    loadSubscriptionStatus();
  }, 1200);
  
  // 1.5秒后检查 UI 更新
  setTimeout(function() {
    checkUIUpdate(true); // 静默模式，不显示"检查中..."提示
  }, 1500);
  
  // 定期更新按钮状态（每3秒检查一次服务状态）
  setInterval(function() {
    updateDownloadButtonState();
    updateUIDownloadButtonState();
  }, 3000);
  
  // 每 10 秒刷新一次订阅流量
  setInterval(function() {
    loadSubscriptionStatus();
  }, 10000);
});

// 填充 Zashboard 访问信息（主机/端口/密码）
document.addEventListener('DOMContentLoaded', function() {
  var elHost = document.getElementById('zash-host');
  if (elHost) {
    elHost.textContent = window.location.hostname || '-';
  }
});

// 同步代码编辑器的滚动偏移量
function syncScroll() {
  var textarea = document.getElementById('editor-textarea');
  var overlay = document.getElementById('highlight-overlay');
  var lineNumbers = document.getElementById('line-numbers');
  
  if (textarea && overlay) {
    overlay.scrollTop = textarea.scrollTop;
    overlay.scrollLeft = textarea.scrollLeft;
  }
  if (textarea && lineNumbers) {
    lineNumbers.scrollTop = textarea.scrollTop;
  }
}

// 实时渲染 YAML 高亮和行号
function updateEditor() {
  var textarea = document.getElementById('editor-textarea');
  var code = document.getElementById('highlight-code');
  var lineNumbers = document.getElementById('line-numbers');
  
  if (!textarea) return;
  
  var text = textarea.value;
  
  if (code) {
    // 确保末尾有空格占位，防止新起一行时光标对齐出现偏差
    code.innerHTML = highlightYaml(text) + (text.endsWith('\n') ? ' ' : '');
  }
  
  if (lineNumbers) {
    var lineCount = text.split('\n').length;
    var linesHtml = '';
    for (var i = 1; i <= lineCount; i++) {
      linesHtml += i + '<br>';
    }
    lineNumbers.innerHTML = linesHtml;
  }
  
  syncScroll();
}

// 轻量级 YAML 语法高亮引擎 (纯正则)
function highlightYaml(text) {
  text = escapeHtml(text);
  
  // 1. 暂存并保护注释 (使用含有下划线及字母的占位符，防止数字或特殊实体被误匹配)
  var comments = [];
  text = text.replace(/#(.*)/g, function(match) {
    comments.push('<span class="yaml-comment">' + match + '</span>');
    return '___COMMENT_PLG_' + (comments.length - 1) + '___';
  });

  // 2. 暂存并保护双引号/单引号内的字符串 (提前保护，避免字符串里的字符被语法分析器匹配)
  var strings = [];
  text = text.replace(/(".*?"|'.*?')/g, function(match) {
    strings.push('<span class="yaml-string">' + match + '</span>');
    return '___STRING_PLG_' + (strings.length - 1) + '___';
  });

  // 3. 提取键名 (Key) - 例如 'dns:', 'enable:'
  text = text.replace(/(^|[\s,{}])([\w.-]+)(\s*:(?=\s|$|\n|\r))/g, '$1<span class="yaml-key">$2</span>$3');

  // 4. 锚点与引用别名 &Anchor, *Alias
  text = text.replace(/(&amp;|\*)[\w.-]+/g, '<span class="yaml-anchor">$&</span>');

  // 5. 布尔值与空值
  text = text.replace(/\b(true|false|null)\b/gi, '<span class="yaml-bool">$&</span>');

  // 6. 数字数值
  text = text.replace(/\b(\d+)\b/g, '<span class="yaml-number">$&</span>');

  // 7. 恢复暂存的字符串
  text = text.replace(/___STRING_PLG_(\d+)___/g, function(match, index) {
    return strings[parseInt(index)];
  });

  // 8. 恢复暂存的注释
  text = text.replace(/___COMMENT_PLG_(\d+)___/g, function(match, index) {
    return comments[parseInt(index)];
  });

  return text;
}

// 拦截配置编辑器的 Tab 键事件，支持插入 2 个空格
document.addEventListener('DOMContentLoaded', function() {
  var textarea = document.getElementById('editor-textarea');
  if (textarea) {
    textarea.addEventListener('keydown', function(e) {
      if (e.key === 'Tab') {
        e.preventDefault();
        var start = this.selectionStart;
        var end = this.selectionEnd;

        // 插入2个空格
        this.value = this.value.substring(0, start) + "  " + this.value.substring(end);

        // 恢复光标位置并更新高亮
        this.selectionStart = this.selectionEnd = start + 2;
        updateEditor();
      }
    });
  }
});

// 日志查看器功能
function openLogViewer() {
  document.getElementById('logModal').style.display = 'block';
  // 自动滚动到底部显示最新日志
  setTimeout(function() {
    var logContent = document.getElementById('logContent');
    logContent.scrollTop = logContent.scrollHeight;
  }, 100);
}

function closeLogViewer() {
  document.getElementById('logModal').style.display = 'none';
}

function refreshLogViewer() {
  // 显示加载状态
  var logContent = document.getElementById('logContent');
  var originalContent = logContent.innerHTML;
  logContent.innerHTML = '<span style="color:#777777;">正在刷新日志...</span>';
  
  // 刷新页面以获取最新日志
  setTimeout(function() {
    window.location.reload();
  }, 500);
}

function executeLogAction(action) {
  var actionText = '';
  switch(action) {
    case 'clearlog': actionText = 'Clear logs'; break;
  }
  
  if (confirm(actionText + '?')) {
    // 显示加载状态
    var logContent = document.getElementById('logContent');
    logContent.innerHTML = '<span style="color:#777777;">正在' + actionText + '...</span>';
    
    // 执行操作
    var url = new URL(window.location);
    url.searchParams.set('cmd', action);
    
    fetch(url.toString())
      .then(function(response) {
        return response.text();
      })
      .then(function(data) {
        // 操作完成后刷新日志
        setTimeout(function() {
          window.location.reload();
        }, 1000);
      })
      .catch(function(error) {
        logContent.innerHTML = '<span style="color:#e74c3c;">操作失败: ' + error + '</span>';
      });
  }
}

// 点击模态框外部关闭
window.onclick = function(event) {
  var logModal = document.getElementById('logModal');
  if (event.target == logModal) {
    closeLogViewer();
  }
}

// ESC键关闭模态框
document.addEventListener('keydown', function(event) {
  if (event.key === 'Escape') {
    closeLogViewer();
  }
});
</script>
</div>
]]></INLINE>
</FILE>

<FILE Name="/usr/local/emhttp/plugins/easy-mihomo/api.php">
<INLINE><![CDATA[
<?php
// 轻量 API：纯文本返回，避免 emhttp 外层 HTML 包装
require_once __DIR__ . '/include/common.php';

header('Content-Type: text/plain; charset=utf-8');

$baseRun = '/usr/local/emhttp/plugins/easy-mihomo';
$scripts = $baseRun . '/scripts';
$progressDir = '/var/tmp/easy-mihomo-progress';
@mkdir($progressDir, 0777, true);

// ==========================================
// Mihomo 本地 API 鉴权与请求助手函数
// ==========================================
function requestMihomoApi($port, $secret, $path, $method = 'GET', $data = null) {
  $url = "http://127.0.0.1:" . $port . $path;
  $header = "Authorization: Bearer " . $secret . "\r\n";
  if ($method === 'PATCH' || $method === 'PUT' || $method === 'POST') {
    $header .= "Content-Type: application/json\r\n";
  }
  
  $opts = [
    'http' => [
      'method' => $method,
      'header' => $header,
      'timeout' => 1.0
    ]
  ];
  
  if ($data !== null) {
    $opts['http']['content'] = json_encode($data);
  }
  
  $context = stream_context_create($opts);
  $response = @file_get_contents($url, false, $context);
  if ($response) {
    return json_decode($response, true);
  }
  return null;
}

$cmd = $_GET['cmd'] ?? $_POST['cmd'] ?? '';
if ($cmd === 'get_progress') {
  $target = $_GET['target'] ?? $_POST['target'] ?? '';
  $file = '';
  if ($target === 'core') $file = $progressDir . '/core.status';
  if ($target === 'ui')   $file = $progressDir . '/ui.status';
  if ($file && is_file($file)) { echo @file_get_contents($file); }
  exit;
}
if ($cmd === 'check_update') {
  header('Content-Type: application/json; charset=utf-8');
  $updateInfo = shell_exec("bash $scripts/check_update.sh 2>&1");
  echo $updateInfo;
  exit;
}
// 检查 UI 更新
if ($cmd === 'check_ui_update') {
  header('Content-Type: application/json; charset=utf-8');
  $uiUpdateInfo = shell_exec("bash $scripts/check_ui_update.sh 2>&1");
  echo $uiUpdateInfo;
  exit;
}
if ($cmd === 'start_download') {
  $target = $_GET['target'] ?? $_POST['target'] ?? '';
  if ($target === 'core') {
    @unlink($progressDir . '/core.status');
    $out = shell_exec("nohup bash $scripts/download_core.sh --progress >$progressDir/core.log 2>&1 & echo $!");
    echo '核心下载任务已启动 PID: ' . trim($out);
  } elseif ($target === 'ui') {
    @unlink($progressDir . '/ui.status');
    $out = shell_exec("nohup bash $scripts/download_ui.sh --progress >$progressDir/ui.log 2>&1 & echo $!");
    echo 'UI 下载任务已启动 PID: ' . trim($out);
  } else {
    echo '未知的下载目标';
  }
  exit;
}
if ($cmd === 'dashboard_status') {
  // 返回 JSON 格式的仪表板数据
  header('Content-Type: application/json; charset=utf-8');
  
  // 1. 获取配置文件的端口和密码信息（用于鉴权）
  $confDir = '/boot/config/plugins/easy-mihomo';
  $selectFile = $confDir . '/selected.conf';
  $selectedName = is_file($selectFile) ? trim(@file_get_contents($selectFile)) : '';
  $selectedPath = ($selectedName && is_file($confDir . '/' . $selectedName)) ? ($confDir . '/' . $selectedName) : '';
  
  $configValues = getMihomoConfigValues($selectedPath);
  $controller = $configValues['controller'];
  $secret = $configValues['secret'];
  $port = $configValues['port'];
  
  // 2. 获取 mihomo 状态
  $status = shell_exec("bash $scripts/status.sh 2>&1");
  $version = shell_exec("bash $scripts/version.sh 2>&1");
  
  $isRunning = strpos($status, 'running') !== false;
  $pid = '';
  if (preg_match('/pid=(\d+)/', $status, $matches)) {
    $pid = $matches[1];
  }
  
  // 3. 获取运行内存 (RSS) 与 CPU
  $memoryUsage = '0 MB';
  $cpuPercent = 0;
  if ($pid) {
    // 内存
    $memoryInfo = shell_exec("ps -o rss= -p $pid 2>/dev/null");
    if ($memoryInfo) {
      $memoryKB = intval(trim($memoryInfo));
      $memoryMB = round($memoryKB / 1024, 1);
      $memoryUsage = $memoryMB . ' MB';
    }
    // CPU
    $cpuInfo = shell_exec("ps -o %cpu= -p $pid 2>/dev/null");
    if ($cpuInfo) {
      $cpuPercent = round(floatval(trim($cpuInfo)));
      if ($cpuPercent > 100) {
        $cpuPercent = 100;
      }
    }
  }
  
  // 4. 获取运行时间信息
  $uptime = '未知';
  if ($pid) {
    $startTime = shell_exec("ps -o lstart= -p $pid 2>/dev/null");
    if ($startTime) {
      $startTimestamp = strtotime(trim($startTime));
      if ($startTimestamp) {
        $currentTime = time();
        $diff = $currentTime - $startTimestamp;
        
        $hours = floor($diff / 3600);
        $minutes = floor(($diff % 3600) / 60);
        
        if ($hours > 0) {
          $uptime = $hours . 'h' . $minutes . 'm';
        } else {
          $uptime = $minutes . 'm';
        }
      }
    }
  }
  
  // 5. 初始化实时监控指标
  $mode = 'rule';
  $connections = 0;
  $downloadTotalStr = '0 B';
  $uploadTotalStr = '0 B';
  $downloadSpeed = '0 B/s';
  $uploadSpeed = '0 B/s';
  $downloadSpeedRaw = 0;
  $uploadSpeedRaw = 0;
  
  // 如果处于运行状态且端口存在，则通过 HTTP REST API 获取实时流量数据
  if ($isRunning && $port) {
    // 5.1 获取代理模式
    $configsData = requestMihomoApi($port, $secret, '/configs');
    if ($configsData && isset($configsData['mode'])) {
      $mode = $configsData['mode'];
    }
    
    // 5.2 获取连接数与总吞吐
    $connectionsData = requestMihomoApi($port, $secret, '/connections');
    if ($connectionsData) {
      $connections = isset($connectionsData['connections']) ? count($connectionsData['connections']) : 0;
      $downloadTotal = isset($connectionsData['downloadTotal']) ? floatval($connectionsData['downloadTotal']) : 0;
      $uploadTotal = isset($connectionsData['uploadTotal']) ? floatval($connectionsData['uploadTotal']) : 0;
      
      $downloadTotalStr = formatBytes($downloadTotal);
      $uploadTotalStr = formatBytes($uploadTotal);
      
      // 5.3 计算实时秒级速度（使用缓存做增量计算，防抖并支持多并发请求）
      $cacheFile = '/tmp/mihomo_traffic_cache.json';
      $currentTime = microtime(true);
      $prevData = null;
      if (is_file($cacheFile)) {
        $prevData = json_decode(@file_get_contents($cacheFile), true);
      }
      
      // 如果上一次计算网速距今不足 1.2 秒，则直接返回上次计算好的速度，不重新计算也不覆盖缓存
      if ($prevData && isset($prevData['time']) && ($currentTime - $prevData['time']) < 1.2) {
        $downloadSpeedRaw = isset($prevData['download_speed_raw']) ? intval($prevData['download_speed_raw']) : 0;
        $uploadSpeedRaw = isset($prevData['upload_speed_raw']) ? intval($prevData['upload_speed_raw']) : 0;
        $downloadSpeed = isset($prevData['download_speed']) ? $prevData['download_speed'] : '0 B/s';
        $uploadSpeed = isset($prevData['upload_speed']) ? $prevData['upload_speed'] : '0 B/s';
      } else {
        // 进行正常的增量速度计算
        $dlDiff = 0;
        $ulDiff = 0;
        if ($prevData && isset($prevData['time'])) {
          $timeDiff = $currentTime - $prevData['time'];
          if ($timeDiff > 0) {
            $dlDiff = $downloadTotal - floatval($prevData['download']);
            $ulDiff = $uploadTotal - floatval($prevData['upload']);
            
            if ($dlDiff < 0) $dlDiff = 0;
            if ($ulDiff < 0) $ulDiff = 0;
            
            $downloadSpeedRaw = round($dlDiff / $timeDiff);
            $uploadSpeedRaw = round($ulDiff / $timeDiff);
            $downloadSpeed = formatBytes($downloadSpeedRaw) . '/s';
            $uploadSpeed = formatBytes($uploadSpeedRaw) . '/s';
          }
        }
        
        // 更新缓存文件
        $cacheData = [
          'time' => $currentTime,
          'download' => $downloadTotal,
          'upload' => $uploadTotal,
          'download_speed_raw' => $downloadSpeedRaw,
          'upload_speed_raw' => $uploadSpeedRaw,
          'download_speed' => $downloadSpeed,
          'upload_speed' => $uploadSpeed
        ];
        @file_put_contents($cacheFile, json_encode($cacheData));
      }
    }
  }
  
  $result = [
    'running' => $isRunning,
    'status' => trim($status),
    'version' => trim($version),
    'pid' => $pid,
    'memory' => $memoryUsage,
    'uptime' => $uptime,
    'cpu' => $cpuPercent,
    'mode' => strtolower($mode),
    'connections' => $connections,
    'download_total' => $downloadTotalStr,
    'upload_total' => $uploadTotalStr,
    'download_speed' => $downloadSpeed,
    'upload_speed' => $uploadSpeed,
    'download_speed_raw' => $downloadSpeedRaw,
    'upload_speed_raw' => $uploadSpeedRaw,
    'config' => [
      'selected_config' => $selectedName,
      'config_path' => $selectedPath,
      'has_config' => !empty($selectedPath),
      'controller' => $controller,
      'secret' => $secret,
      'port' => $port
    ]
  ];
  
  echo json_encode($result);
  exit;
}
if ($cmd === 'set_mode') {
  $mode = $_GET['mode'] ?? $_POST['mode'] ?? '';
  if (!$mode) {
    echo 'error: mode parameter missing';
    exit;
  }
  
  $confDir = '/boot/config/plugins/easy-mihomo';
  $selectFile = $confDir . '/selected.conf';
  $selectedName = is_file($selectFile) ? trim(@file_get_contents($selectFile)) : '';
  $selectedPath = ($selectedName && is_file($confDir . '/' . $selectedName)) ? ($confDir . '/' . $selectedName) : '';
  
  $configValues = getMihomoConfigValues($selectedPath);
  $secret = $configValues['secret'];
  $port = $configValues['port'];
  
  if (!$port) {
    echo 'error: controller port not found';
    exit;
  }
  
  // 发送 PATCH /configs 请求切换模式
  requestMihomoApi($port, $secret, '/configs', 'PATCH', ['mode' => $mode]);
  echo 'success';
  exit;
}
if ($cmd === 'subscription_status') {
  header('Content-Type: application/json; charset=utf-8');
  
  $confDir = '/boot/config/plugins/easy-mihomo';
  $selectFile = $confDir . '/selected.conf';
  $selectedName = is_file($selectFile) ? trim(@file_get_contents($selectFile)) : '';
  $selectedPath = ($selectedName && is_file($confDir . '/' . $selectedName)) ? ($confDir . '/' . $selectedName) : '';
  
  $configValues = getMihomoConfigValues($selectedPath);
  $secret = $configValues['secret'];
  $port = $configValues['port'];
  
  // 检查 mihomo 状态
  $status = shell_exec("bash $scripts/status.sh 2>&1");
  $isRunning = strpos($status, 'running') !== false;
  
  $subs = [];
  if ($isRunning && $port) {
    $providersData = requestMihomoApi($port, $secret, '/providers/proxies');
    if ($providersData && isset($providersData['providers'])) {
      foreach ($providersData['providers'] as $name => $p) {
        // 读取大写的 subscriptionInfo (Mihomo 专属)
        $subInfo = $p['subscriptionInfo'] ?? null;
        // 兼容读取小写的 subscriptionUserinfo (Clash 传统)
        if (!$subInfo && isset($p['subscriptionUserinfo'])) {
          $subInfo = $p['subscriptionUserinfo'];
        }
        
        if ($subInfo) {
          // 统一大小写属性名提取数据
          $upload = floatval($subInfo['Upload'] ?? $subInfo['upload'] ?? 0);
          $download = floatval($subInfo['Download'] ?? $subInfo['download'] ?? 0);
          $total = floatval($subInfo['Total'] ?? $subInfo['total'] ?? 0);
          $expire = intval($subInfo['Expire'] ?? $subInfo['expire'] ?? 0);
          
          if ($total > 0) {
            $used = $upload + $download;
            $remaining = $total - $used;
            if ($remaining < 0) $remaining = 0;
            
            $percent = round(($used / $total) * 100, 2);
            if ($percent > 100) $percent = 100;
            
            $expireDate = '永久有效';
            if ($expire > 0) {
              $expireDate = date('Y-m-d', $expire);
            }
            
            $subs[] = [
              'name' => $name,
              'used' => formatBytes($used),
              'total' => formatBytes($total),
              'remaining' => formatBytes($remaining),
              'percent' => $percent,
              'expire' => $expireDate
            ];
          }
        }
      }
    }
  }
  
  echo json_encode($subs);
  exit;
}
if ($cmd === 'start') {
  $out = shell_exec("bash $scripts/start.sh 2>&1");
  echo htmlspecialchars($out ?? '');
  exit;
}
if ($cmd === 'stop') {
  $out = shell_exec("bash $scripts/stop.sh 2>&1");
  echo htmlspecialchars($out ?? '');
  exit;
}
if ($cmd === 'restart') {
  $out = shell_exec("bash $scripts/restart.sh 2>&1");
  echo htmlspecialchars($out ?? '');
  exit;
}
echo 'unknown command';
]]></INLINE>
</FILE>

<!-- scripts -->
<FILE Name="/usr/local/emhttp/plugins/easy-mihomo/scripts/start.sh" Mode="0755">
<INLINE><![CDATA[
#!/bin/bash
set -e
BIN="/usr/local/bin/mihomo"
CONF_DIR="/boot/config/plugins/easy-mihomo"
SELECT_FILE="$CONF_DIR/selected.conf"
if [ -f "$SELECT_FILE" ]; then
  NAME=$(cat "$SELECT_FILE" 2>/dev/null || true)
  if [ -n "$NAME" ] && [ -f "$CONF_DIR/$NAME" ]; then
    CONF_FILE="$CONF_DIR/$NAME"
  else
    echo "未找到有效的已选配置 ("$NAME")" >&2; exit 1
  fi
else
  echo "未选择配置，请先在页面中选择" >&2; exit 1
fi
LOG_FILE="/var/log/mihomo.log"
PID_FILE="/var/run/mihomo.pid"

# 防重复启动检查（必须在最前面）
if [ -f "$PID_FILE" ]; then
  PID=$(cat "$PID_FILE" 2>/dev/null || true)
  if [ -n "$PID" ] && ps -p "$PID" >/dev/null 2>&1; then
    echo "running (pid $PID)"
    exit 0
  fi
fi

# 启动前清理日志（防止日志过大影响性能）
LOG_CLEANUP_SCRIPT="/usr/local/emhttp/plugins/easy-mihomo/scripts/log_cleanup.sh"
if [ -x "$LOG_CLEANUP_SCRIPT" ]; then
  "$LOG_CLEANUP_SCRIPT" >/dev/null 2>&1 || true
fi

# 简化核心文件检查（不再比较版本号）
# 原理：下载核心时会删除内存文件，下次启动时自动从U盘复制最新版本
  UDISK_BIN="/boot/config/plugins/easy-mihomo/mihomo"

# 检查U盘核心是否存在
if [ ! -f "$UDISK_BIN" ]; then
  if [ ! -f "$BIN" ]; then
    echo "核心文件缺失，请先下载核心" >> "$LOG_FILE" 2>&1
    echo "核心文件缺失，请先下载核心"
    exit 1
  fi
  # U盘没有但内存有（罕见情况），继续使用内存版本
  echo "警告：U盘核心文件不存在，使用内存现有版本" >> "$LOG_FILE" 2>&1
else
  # 检查内存中是否有核心
  if [ ! -f "$BIN" ]; then
    # 内存中不存在，从U盘复制（首次启动或更新核心后）
    echo "检测到内存中无核心文件，从U盘复制..." >> "$LOG_FILE" 2>&1
    mkdir -p /usr/local/bin
    cp -f "$UDISK_BIN" "$BIN"
    chmod +x "$BIN"
    echo "核心文件已从U盘复制到内存" >> "$LOG_FILE" 2>&1
  else
    # 内存中已存在，直接使用（不进行版本比较）
    echo "核心文件就绪，直接启动" >> "$LOG_FILE" 2>&1
  fi
fi

# UI 运行于内存，直接修改配置文件路径指向内存目录
UI_ZIP_PATH="/boot/config/plugins/easy-mihomo/zashboard.zip"
UI_RAM_DIR="/var/tmp/easy-mihomo-ui/zashboard"

# 每次启动都重新解压UI到内存（确保最新）
if [ -f "$UI_ZIP_PATH" ]; then
  echo "解压 UI 到内存（覆盖）..." >> "$LOG_FILE" 2>&1
  rm -rf "$UI_RAM_DIR" && mkdir -p "$UI_RAM_DIR"
  if command -v unzip >/dev/null 2>&1; then
    unzip -oq "$UI_ZIP_PATH" -d "$UI_RAM_DIR" >> "$LOG_FILE" 2>&1 || true
  elif command -v busybox >/dev/null 2>&1; then
    busybox unzip -oq "$UI_ZIP_PATH" -d "$UI_RAM_DIR" >> "$LOG_FILE" 2>&1 || true
  fi
  # 若有 dist/ 子目录，上移其内容并删除
  if [ -d "$UI_RAM_DIR/dist" ]; then
    cp -rf "$UI_RAM_DIR/dist/." "$UI_RAM_DIR/" 2>>"$LOG_FILE" || true
    rm -rf "$UI_RAM_DIR/dist" 2>>"$LOG_FILE" || true
  fi
  echo "UI 解压完成" >> "$LOG_FILE" 2>&1
else
  echo "UI zip文件不存在，跳过解压" >> "$LOG_FILE" 2>&1
fi

# 在mihomo工作目录内创建bind mount指向内存UI目录
UI_MOUNT_DIR="/boot/config/plugins/easy-mihomo/ui/zashboard"
echo "创建UI bind mount..." >> "$LOG_FILE" 2>&1

# 确保目标目录存在
mkdir -p "$UI_MOUNT_DIR" 2>>"$LOG_FILE" || true

# 如果已经挂载，先卸载
if mountpoint -q "$UI_MOUNT_DIR" 2>/dev/null; then
  echo "卸载现有bind mount: $UI_MOUNT_DIR" >> "$LOG_FILE" 2>&1
  umount "$UI_MOUNT_DIR" 2>>"$LOG_FILE" || umount -l "$UI_MOUNT_DIR" 2>>"$LOG_FILE" || true
fi

# 清理目录内容（如果存在）
if [ -d "$UI_MOUNT_DIR" ] && [ ! -L "$UI_MOUNT_DIR" ]; then
  echo "清理目录内容: $UI_MOUNT_DIR" >> "$LOG_FILE" 2>&1
  rm -rf "$UI_MOUNT_DIR"/* 2>>"$LOG_FILE" || true
fi

# 创建bind mount
echo "创建bind mount: $UI_MOUNT_DIR <- $UI_RAM_DIR" >> "$LOG_FILE" 2>&1
mount --bind "$UI_RAM_DIR" "$UI_MOUNT_DIR" 2>>"$LOG_FILE" || {
  echo "bind mount创建失败，尝试清理后重试..." >> "$LOG_FILE" 2>&1
  # 如果失败，清理目录后重试
  rm -rf "$UI_MOUNT_DIR" 2>>"$LOG_FILE" || true
  mkdir -p "$UI_MOUNT_DIR" 2>>"$LOG_FILE" || true
  mount --bind "$UI_RAM_DIR" "$UI_MOUNT_DIR" 2>>"$LOG_FILE" || true
}

# 验证bind mount是否成功
if mountpoint -q "$UI_MOUNT_DIR" 2>/dev/null; then
  echo "bind mount创建成功" >> "$LOG_FILE" 2>&1
else
  echo "bind mount创建失败，使用软链接作为备选方案..." >> "$LOG_FILE" 2>&1
  rm -rf "$UI_MOUNT_DIR" 2>>"$LOG_FILE" || true
  ln -s "$UI_RAM_DIR" "$UI_MOUNT_DIR" 2>>"$LOG_FILE" || true
fi

# 检查并修复配置文件中的UI路径
if [ -f "$CONF_FILE" ]; then
  # 进行标准化处理前，备份一次配置（仅保留单个备份文件）
  cp "$CONF_FILE" "$CONF_FILE.bak" 2>/dev/null || true

  # 只覆写UI相关配置项，保障UI功能正常
  DESIRED_UI_URL="https://github.com/Zephyruso/zashboard/releases/latest/download/dist.zip"
  DESIRED_UI_NAME="zashboard"
  DESIRED_UI_PATH="ui"

  upsert_yaml_key(){
    local key="$1"; shift
    local val="$1"; shift
    # 转义 / 和 &，避免 sed 替换冲突
    local esc_val
    esc_val=$(printf '%s' "$val" | sed 's/[&\/]/\\&/g')
    if grep -qE "^${key}:" "$CONF_FILE"; then
      sed -i "s|^${key}:.*|${key}: ${esc_val}|g" "$CONF_FILE"
    else
      echo "${key}: ${val}" >> "$CONF_FILE"
    fi
  }

  echo "标准化UI配置项（external-ui-url / external-ui-name / external-ui）..." >> "$LOG_FILE" 2>&1
  upsert_yaml_key "external-ui-url" "$DESIRED_UI_URL"
  upsert_yaml_key "external-ui-name" "$DESIRED_UI_NAME"
  upsert_yaml_key "external-ui" "$DESIRED_UI_PATH"
else
  echo "配置文件不存在，跳过UI路径检查" >> "$LOG_FILE" 2>&1
fi

if [ ! -x "$BIN" ]; then echo "二进制缺失: $BIN" >&2; exit 1; fi
if [ ! -f "$CONF_FILE" ]; then echo "配置文件缺失: $CONF_FILE" >&2; exit 1; fi

# 尝试加载 TUN（忽略失败）
modprobe tun 2>/dev/null || true

# 后台启动
nohup "$BIN" -d "$CONF_DIR" -f "$CONF_FILE" >> "$LOG_FILE" 2>&1 &
NEWPID=$!
echo $NEWPID > "$PID_FILE"
sleep 1

if ps -p "$NEWPID" >/dev/null 2>&1; then
  echo "started (pid $NEWPID)"
  exit 0
else
  echo "start failed, see $LOG_FILE" >&2
  exit 1
fi
]]></INLINE>
</FILE>
<FILE Name="/usr/local/emhttp/plugins/easy-mihomo/scripts/stop.sh" Mode="0755">
<INLINE><![CDATA[
#!/bin/bash
set -e
PID_FILE="/var/run/mihomo.pid"

# 优先按 pidfile 停止
if [ -f "$PID_FILE" ]; then
  PID=$(cat "$PID_FILE" 2>/dev/null || true)
  if [ -n "$PID" ] && ps -p "$PID" >/dev/null 2>&1; then
    kill "$PID" 2>/dev/null || true
  fi
fi

# 兜底按进程名停止
if pgrep -x mihomo >/dev/null 2>&1; then
  # 等待优雅退出
  for i in $(seq 1 5); do
    if pgrep -x mihomo >/dev/null 2>&1; then
      sleep 1
    else
      break
    fi
  done
  # 仍存活则强杀
  if pgrep -x mihomo >/dev/null 2>&1; then
    pkill -9 -x mihomo 2>/dev/null || true
  fi
fi

# 清理UI bind mount或软链接
UI_MOUNT_DIR="/boot/config/plugins/easy-mihomo/ui/zashboard"
if mountpoint -q "$UI_MOUNT_DIR" 2>/dev/null; then
  echo "卸载bind mount: $UI_MOUNT_DIR" >&2
  umount "$UI_MOUNT_DIR" 2>/dev/null || umount -l "$UI_MOUNT_DIR" 2>/dev/null || true
elif [ -L "$UI_MOUNT_DIR" ]; then
  echo "清理软链接: $UI_MOUNT_DIR" >&2
  rm -f "$UI_MOUNT_DIR" 2>/dev/null || true
elif [ -d "$UI_MOUNT_DIR" ]; then
  echo "清理目录: $UI_MOUNT_DIR" >&2
  rm -rf "$UI_MOUNT_DIR" 2>/dev/null || true
fi

# 清理 pidfile（若进程已不存在）
if [ -f "$PID_FILE" ]; then
  if ! ps -p $(cat "$PID_FILE" 2>/dev/null || echo 0) >/dev/null 2>&1; then
    rm -f "$PID_FILE"
  fi
fi

echo "stopped"
]]></INLINE>
</FILE>
<FILE Name="/usr/local/emhttp/plugins/easy-mihomo/scripts/restart.sh" Mode="0755">
<INLINE><![CDATA[
#!/bin/bash
set -e
SCRIPT_DIR="/usr/local/emhttp/plugins/easy-mihomo/scripts"

bash "$SCRIPT_DIR/stop.sh" || true
sleep 1
bash "$SCRIPT_DIR/start.sh"
]]></INLINE>
</FILE>
<FILE Name="/usr/local/emhttp/plugins/easy-mihomo/scripts/status.sh" Mode="0755">
<INLINE><![CDATA[
#!/bin/bash
set -e
PID_FILE="/var/run/mihomo.pid"
STATUS="stopped"; PID=""
if pgrep -x mihomo >/dev/null 2>&1; then STATUS="running"; PID=$(pgrep -x mihomo | head -n1); fi
echo "status=$STATUS pid=$PID"
]]></INLINE>
</FILE>
<FILE Name="/usr/local/emhttp/plugins/easy-mihomo/scripts/version.sh" Mode="0755">
<INLINE><![CDATA[
#!/bin/bash
set -e
VERSION_FILE="/boot/config/plugins/easy-mihomo/.version"

# 读取版本文件（格式：版本号|版本类型，例如：1.19.15|v3）
if [ -f "$VERSION_FILE" ]; then
  CONTENT=$(cat "$VERSION_FILE" 2>/dev/null | tr -d '\n\r' || echo "")
  if [ -n "$CONTENT" ]; then
    # 提取版本号（分隔符前的部分）
    VERSION=$(echo "$CONTENT" | cut -d'|' -f1)
    if [ -n "$VERSION" ]; then
      echo "$VERSION"
      exit 0
    fi
  fi
fi

# 版本文件不存在或为空
echo "unknown"
]]></INLINE>
</FILE>
